# A2A.FUN game server environment. Copy to `.env` (gitignored) and fill in.

# Postgres connection string (Prisma).
DATABASE_URL="postgresql://user:pass@127.0.0.1:5432/globefly?schema=public"

# Port the game server listens on.
PORT=3001

# Public URL of the web client (for CORS allow-list).
CLIENT_URL=http://localhost:5173

# ── Pouchy AI companion (server-minted session tokens) ──
# The backend mints short-lived companion session tokens from the owner's
# Secret Key, so the browser never holds a long-lived PAT. Powers
# POST /api/pouchy-session (client/src/companion/pouchySession.ts).
# If these are unset, the endpoint returns 503 and the game simply runs with
# NO companion (graceful — not an error).
#
# Secret Key (pchy_sk_…) — BACKEND ONLY. Never expose to the client / commit it.
POUCHY_SECRET_KEY=
# The Pouchy Agent id for this game (from the dashboard).
POUCHY_AGENT_ID=
# Optional — Pouchy platform base URL for minting. Defaults to the canonical
# https://www.pouchy.ai — the apex pouchy.ai redirects POST /v1/sessions to www,
# and fetch drops the Authorization header on that cross-origin redirect (→ 401).
# POUCHY_BASE_URL=https://www.pouchy.ai
